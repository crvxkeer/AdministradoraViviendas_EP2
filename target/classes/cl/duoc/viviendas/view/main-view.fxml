<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cl.duoc.viviendas.controller.MainController"
      prefHeight="700"
      prefWidth="900">

    <Label text="Administradora de Viviendas"/>

    <HBox spacing="10">

        <Label text="Tipo"/>

        <ComboBox fx:id="cboTipo"/>

        <Label text="Código"/>

        <TextField fx:id="txtCodigo"/>

    </HBox>

    <HBox spacing="10">

        <Label text="Superficie"/>

        <TextField fx:id="txtSuperficie"/>

        <Label text="Habitaciones"/>

        <TextField fx:id="txtHabitaciones"/>

    </HBox>

    <HBox spacing="10">

        <Label text="Piso"/>

        <TextField fx:id="txtPiso"/>

        <CheckBox
                fx:id="chkGastoComun"
                text="Gasto común al día"/>

        <CheckBox
                fx:id="chkEstacionamiento"
                text="Estacionamiento"/>

        <CheckBox
                fx:id="chkPatio"
                text="Patio"/>

    </HBox>

    <HBox spacing="10">

        <Button
                text="Registrar"
                onAction="#registrar"/>

        <Button
                text="Eliminar"
                onAction="#eliminar"/>

    </HBox>

    <TableView
            fx:id="tblViviendas"
            prefHeight="400">

        <columns>

            <TableColumn
                    fx:id="colTipo"
                    text="Tipo"/>

            <TableColumn
                    fx:id="colCodigo"
                    text="Código"/>

            <TableColumn
                    fx:id="colSuperficie"
                    text="Superficie"/>

            <TableColumn
                    fx:id="colHabitaciones"
                    text="Habitaciones"/>

            <TableColumn
                    fx:id="colCosto"
                    text="Costo Arriendo"/>

        </columns>

    </TableView>

    <Label fx:id="lblMensaje"/>

</VBox>